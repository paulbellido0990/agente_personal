{
  "name": "alira-server",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "test": "node --test tests/*.test.js",
    "db:inspect": "node --env-file-if-exists=.env scripts/inspect-db.js",
    "admin:create": "node --env-file-if-exists=.env scripts/admin-create.js",
    "db:backup": "node --env-file-if-exists=.env scripts/backup.js",
    "db:restore": "node --env-file-if-exists=.env scripts/restore.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pdfkit": "^0.17.2"
  }
}
